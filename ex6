<!DOCTYPE html>
<html>
<head>
    <title>Employee Management Dashboard</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <style>
        body {
            font-family: Arial;
            margin: 30px;
            background-color: #f7f0ff;
        }
        h1 {
            text-align: center;
            background-color: #6a1b9a;
            color: white;
            padding: 15px;
        }
        .form {
            background-color: white;
            padding: 20px;
            margin-bottom: 20px;
            border: 2px solid #8e44ad;
            border-radius: 10px;
        }
        input {
            padding: 8px;
            margin: 5px;
            border: 1px solid #ba68c8;
            border-radius: 5px;
        }
        button {
            padding: 8px 15px;
            margin: 5px;
            cursor: pointer;
            border: 1px solid #8e44ad;
            background-color: white;
            color: #6a1b9a;
            border-radius: 5px;
        }
        button:hover {
            background-color: #e1bee7;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }
        th {
            background-color: #8e44ad;
            color: white;
            padding: 10px;
        }
        td {
            border: 1px solid #ce93d8;
            padding: 10px;
            text-align: center;
        }
        .selected {
            background-color: #ffcc80;
        }
        .panel {
            background-color: white;
            padding: 15px;
            margin-top: 20px;
            border: 2px solid #8e44ad;
            border-radius: 8px;
        }
        #status {
            font-weight: bold;
            color: #e91e63;
        }
    </style>
    <script>
        $(document).ready(function () {
            $("table").on("click", ".selectBtn", function () {
                let row = $(this).closest("tr");
                let id = row.find(".empId").text();
                let name = row.find(".empName").text();
                let dept = row.find(".empDept").text();
                $("#empId").val(id);
                $("#empName").val(name);
                $("#department").val(dept);
                $(".selected").removeClass("selected");
                row.addClass("selected");
                $("#status").text(
                    "Selected employee details loaded."
                );
            });
            $("#update").click(function () {
                let id = $("#empId").val();
                let name = $("#empName").val();
                let dept = $("#department").val();
                if (id == "" || name == "" || dept == "") {
                    alert("Please enter all employee details.");
                    return;
                }
                let row = $(".selected");
                if (row.length == 0) {
                    alert("Please select an employee to update.");
                    return;
                }
                row.find(".empId").text(id);
                row.find(".empName").text(name);
                row.find(".empDept").text(dept);
                $("#status").text(
                    "Employee updated successfully."
                );
            });
            $("#add").click(function () {
                let id = $("#empId").val();
                let name = $("#empName").val();
                let dept = $("#department").val();
                if (id == "" || name == "" || dept == "") {
                    alert("Please enter all employee details.");
                    return;
                }
                let newRow =
                    "<tr>" +
                    "<td class='empId'>" + id + "</td>" +
                    "<td class='empName'>" + name + "</td>" +
                    "<td class='empDept'>" + dept + "</td>" +
                    "<td><button class='selectBtn'>Select</button></td>" +
                    "</tr>";
                $("#employeeTable tbody").append(newRow);
                $("#status").text(
                    "Employee added successfully."
                );
            });
            $("#remove").click(function () {
                let row = $(".selected");
                if (row.length == 0) {
                    alert("Please select an employee to remove.");
                    return;
                }
                row.remove();
                $("#status").text(
                    "Employee removed successfully."
                );
            });
            $("#highlight").click(function () {
                let row = $(".selected");
                if (row.length == 0) {
                    alert("Please select an employee.");
                    return;
                }
                row.toggleClass("selected");
            })
            $("#changeColor").click(function () {

                $(".panel").css({

                    "background-color": "#f3e5f5",
                    "border": "2px solid #9c27b0"

                });

                $("#status").text(
                    "Information panel style changed."
                );

            });

            $("#dimensions").click(function () {

                let width = $("#employeeTable").width();
                let height = $("#employeeTable").height();

                $("#dimension").text(

                    "Table Width: " + width +
                    " px | Table Height: " + height + " px"

                );
            });
            $("#clear").click(function () {

                $("#empId").val("");
                $("#empName").val("");
                $("#department").val("");

                $(".selected").removeClass("selected");

                $("#status").text("");
                $("#dimension").text("");

            });
        });
    </script>
</head>
<body>
    <h1>Employee Management Dashboard</h1>
    <div class="form">
        <h2>Employee Details</h2>
        Employee ID:
        <input type="text" id="empId">

        Employee Name:
        <input type="text" id="empName">

        Department:
        <input type="text" id="department">

        <br><br>

        <button id="add">
            Add Employee
        </button>

        <button id="update">
            Update Employee
        </button>

        <button id="remove">
            Remove Employee
        </button>

        <button id="highlight">
            Highlight
        </button>

        <button id="changeColor">
            Change Panel Style
        </button>

        <button id="dimensions">
            Show Table Dimensions
        </button>

        <button id="clear">
            Clear
        </button>

    </div>
    <table id="employeeTable">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>Employee Name</th>
                <th>Department</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="empId">201</td>
                <td class="empName">Dafni</td>
                <td class="empDept">CSE</td>
                <td>
                    <button class="selectBtn">
                        Select
                    </button>
                </td>
            </tr>
            <tr>
                <td class="empId">202</td>
                <td class="empName">Ananya</td>
                <td class="empDept">IT</td>

                <td>
                    <button class="selectBtn">
                        Select
                    </button>
                </td>
            </tr>
            <tr>
                <td class="empId">203</td>
                <td class="empName">Keerthi</td>
                <td class="empDept">AI & ML</td>
                <td>
                    <button class="selectBtn">
                        Select
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
    <div class="panel">
        <h3>Status</h3>
        <p id="status"></p>
        <p id="dimension"></p>
    </div>
</body>
</html>
